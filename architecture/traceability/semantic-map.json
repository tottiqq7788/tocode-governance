{
  "schema_version": "semantic-map:v0.1",
  "l0_rules": [
    {
      "id": "l0-root",
      "name": "根文件夹",
      "status": "approved",
      "statement": "系统始终维护一个唯一的「根文件夹」路径作为目录浏览起点；首次启动时若无根文件夹则默认使用「/Users/admin/Documents」作为根文件夹（不弹选择器），之后可在菜单中修改或重置。",
      "source_refs": ["user-requirement:2026-09-03", "user-requirement:2026-09-04"]
    },
    {
      "id": "l0-navigate",
      "name": "左键浏览目录",
      "status": "approved",
      "statement": "左键单击菜单栏图标时，弹出目录树并显示根文件夹下的第一层文件与文件夹（可递归展开），不包含功能项。",
      "source_refs": ["user-requirement:2026-09-03", "user-feedback:2026-09-03"]
    },
    {
      "id": "l0-recurse",
      "name": "递归展开子文件夹",
      "status": "approved",
      "statement": "任意层级的子文件夹都可以继续向下展开，显示其下级的文件与文件夹（可无限递归）。",
      "source_refs": ["user-requirement:2026-09-03"]
    },
    {
      "id": "l0-copy-path",
      "name": "复制路径",
      "status": "approved",
      "statement": "点击任一文件或文件夹条目时，将该条目的绝对路径以「路径」格式（全角括号包裹）复制到系统剪贴板。",
      "source_refs": ["user-requirement:2026-09-03", "user-feedback:2026-09-03"]
    },
    {
      "id": "l0-hover-expand",
      "name": "悬停展开文件夹",
      "status": "approved",
      "statement": "鼠标悬停文件夹条目时通过原生子菜单展开显示其下级内容；点击文件夹条目时复制其路径（悬停展开、点击复制）。",
      "source_refs": ["user-requirement:2026-09-03", "user-feedback:2026-09-03"]
    },
    {
      "id": "l0-action-menu",
      "name": "右键功能菜单",
      "status": "approved",
      "statement": "右键单击菜单栏图标时，弹出功能菜单，包含「读取剪贴板」「更改目录」「重置初始目录」「退出」四项，每项左侧带图标。",
      "source_refs": ["user-feedback:2026-09-03", "user-requirement:2026-09-04"]
    },
    {
      "id": "l0-set-root-clipboard",
      "name": "读取剪贴板设根",
      "status": "approved",
      "statement": "右键功能菜单中的「读取剪贴板」被选中时，若当前系统剪贴板的文本是一个不带「」包裹的、真实存在的文件夹路径，则将该路径设为新的根文件夹并弹出一条系统通知；否则不改变根文件夹。",
      "source_refs": ["user-requirement:2026-09-03", "user-feedback:2026-09-03"]
    },
    {
      "id": "l0-show-hidden",
      "name": "显示隐藏文件",
      "status": "approved",
      "statement": "目录列表包含以点（.）开头的隐藏文件与隐藏文件夹（如 .DS_Store、.git）。",
      "source_refs": ["user-requirement:2026-09-03"]
    },
    {
      "id": "l0-reset-root",
      "name": "重置初始目录",
      "status": "approved",
      "statement": "右键功能菜单中的「重置初始目录」被选中时，将根文件夹设为默认目录「/Users/admin/Documents」，并弹出一条系统通知。",
      "source_refs": ["user-requirement:2026-09-04"]
    }
  ],
  "l1_responsibilities": [
    {
      "id": "l1-root-state",
      "name": "根文件夹状态",
      "status": "candidate",
      "responsibility": "维护根文件夹路径的持久化存储、读取与修改（首次默认、菜单修改、剪贴板设置、重置为默认目录）。",
      "l0_refs": ["l0-root", "l0-set-root-clipboard", "l0-reset-root"],
      "owners": ["architecture_owner"],
      "reviewers": ["implementation_owner", "independent_reviewer"]
    },
    {
      "id": "l1-menu-navigation",
      "name": "目录菜单渲染",
      "status": "candidate",
      "responsibility": "将目录内容渲染为菜单树，支持任意层级递归展开，并包含隐藏文件。",
      "l0_refs": ["l0-navigate", "l0-recurse", "l0-show-hidden"],
      "owners": ["architecture_owner"],
      "reviewers": ["implementation_owner", "independent_reviewer"]
    },
    {
      "id": "l1-copy-interaction",
      "name": "复制与悬停交互",
      "status": "candidate",
      "responsibility": "实现悬停文件夹展开、点击文件或文件夹复制路径，均以「路径」格式写入剪贴板。",
      "l0_refs": ["l0-copy-path", "l0-hover-expand"],
      "owners": ["architecture_owner"],
      "reviewers": ["implementation_owner", "independent_reviewer"]
    },
    {
      "id": "l1-status-bar",
      "name": "菜单栏图标与事件",
      "status": "candidate",
      "responsibility": "承载菜单栏图标，左键弹出目录树、右键弹出功能菜单，并在设根或重置成功后发送系统通知。",
      "l0_refs": ["l0-navigate", "l0-action-menu", "l0-set-root-clipboard", "l0-reset-root"],
      "owners": ["architecture_owner"],
      "reviewers": ["implementation_owner", "independent_reviewer"]
    },
    {
      "id": "l1-filesystem",
      "name": "文件系统访问",
      "status": "candidate",
      "responsibility": "枚举目录内容、判断条目是文件还是文件夹、判断路径是否存在、读取隐藏文件。",
      "l0_refs": ["l0-recurse", "l0-show-hidden", "l0-set-root-clipboard"],
      "owners": ["architecture_owner"],
      "reviewers": ["implementation_owner", "independent_reviewer"]
    }
  ],
  "l2_components": [
